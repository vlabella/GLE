! basic_math.gle
include "console.gle"

!-----------------------------------------------------------------------------
! basic_math.gle
!
! Basic regression tests for GLE mathematical operations
!-----------------------------------------------------------------------------

include "console.gle"


!-----------------------------------------------------------------------------
! Tests
!-----------------------------------------------------------------------------

assert_equal "addition: 2 + 2"       2+2      4
assert_equal "subtraction: 10 - 3"   10-3     7
assert_equal "multiplication: 6 * 7" 6*7      42
assert_equal "division: 20 / 4"      20/4     5

assert_close "division: 1 / 3"       1/3      0.3333333333333333  1e-12
assert_close "sqrt(2)"               sqrt(2)    1.4142135623730951  1e-12
assert_close "sin(pi / 2)"           sin(pi/2)  1                    1e-12
assert_close "cos(pi)"               cos(pi)   -1                    1e-12


!-----------------------------------------------------------------------------
! Summary
!-----------------------------------------------------------------------------

test_summary

